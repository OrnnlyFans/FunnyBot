# ============================================================
#  FunnyBot — Game Night Discord Bot  ( copy to ".env" )
#  Get your bot token from the Discord Developer Portal:
#  https://discord.com/developers/applications
# ============================================================

# Bot token (KEEP THIS SECRET — never commit .env)
TOKEN=YOUR_BOT_TOKEN_HERE

# Your bot's Application (client) ID
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Guild (server) where slash commands should be registered.
# Leave empty to register commands GLOBALLY (takes up to 1 hour to appear).
# For testing, set this to your server's ID for instant command availability.
GUILD_ID=YOUR_GUILD_ID_HERE
